      "html": "<nav class=\"ds-site-nav\" aria-label=\"Main navigation\"><a href=\"/services\" aria-current=\"page\">Services</a><a href=\"/about\">About Powertek</a><a href=\"/contact\">Contact</a></nav>",
      "css": ".ds-site-nav{display:flex;gap:32px;background:var(--pt-site-bg,#fff);padding:16px}.ds-site-nav a{font:550 13px/1.7 Inter,system-ui,sans-serif;color:var(--pt-site-muted,#53647d);padding:12px 0;min-height:44px;text-decoration:none}.ds-site-nav a:hover,.ds-site-nav a[aria-current]{color:var(--pt-site-link,#153a88)}.ds-site-nav a[aria-current]{text-decoration:underline;text-decoration-color:#ff8d2a;text-underline-offset:10px;text-decoration-thickness:2px}.ds-site-nav a:focus-visible{outline:3px solid #ff8d2a;outline-offset:4px}"
    },
    {
