      "css": ".ds-site-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:12px 20px;border-radius:8px;border:1px solid transparent;font:600 13px/1.6 Inter,system-ui,sans-serif;letter-spacing:-.01em;text-align:center;text-decoration:none;cursor:pointer;transition:background-color .16s,color .16s,transform .16s}.ds-site-button:focus-visible{outline:3px solid var(--pt-site-orange,#ff8d2a);outline-offset:4px}.ds-site-button:disabled{cursor:not-allowed}.ds-site-secondary{background:var(--pt-site-bg,#fff);color:var(--pt-site-ink,#162c53);border-color:var(--pt-site-line,#dce4ef)}.ds-site-secondary:hover{background:var(--pt-site-soft,#f2f5fa)}"
