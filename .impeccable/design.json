  "components": [
    {
      "name": "Workspace Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary operational action.",
      "html": "<button class=\"ds-primary\">New project</button>",
      "css": ".ds-primary,.ds-secondary,.ds-home{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 14px;border-radius:8px;font:600 12px Inter,system-ui,sans-serif;min-height:42px;cursor:pointer;transition:background-color .16s,border-color .16s,box-shadow .16s,transform .16s}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-home:focus-visible{outline:3px solid var(--brand-orange,#ff8d2a);outline-offset:3px}.ds-primary{background:var(--brand-navy,#0c2170);color:#fff;border:1px solid var(--brand-navy,#0c2170);box-shadow:0 3px 7px #0c217016}.ds-primary:hover{background:#17318a}.ds-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Workspace Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Supporting actions such as export and refresh.",
      "html": "<button class=\"ds-secondary\">Export summary</button>",
      "css": ".ds-primary,.ds-secondary,.ds-home{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:9px 14px;border-radius:8px;font:600 12px Inter,system-ui,sans-serif;min-height:42px;cursor:pointer;transition:background-color .16s,border-color .16s,box-shadow .16s,transform .16s}.ds-primary:focus-visible,.ds-secondary:focus-visible,.ds-home:focus-visible{outline:3px solid var(--brand-orange,#ff8d2a);outline-offset:3px}.ds-secondary{background:var(--workspace-panel,#fff);color:var(--workspace-text,#19273d);border:1px solid var(--workspace-line,#dce4ef)}.ds-secondary:hover{background:var(--workspace-soft,#edf2f8)}.ds-secondary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Authentication Field",
      "kind": "input",
      "refersTo": "input-auth",
      "description": "Shared sign-in, recovery and password-setting field.",
      "html": "<label class=\"ds-label\">Work email<span class=\"ds-field\"><input type=\"email\" autocomplete=\"email\" placeholder=\"you@company.com\" /></span></label>",
      "css": ".ds-label{display:grid;gap:8px;font:550 13px Inter,system-ui,sans-serif;color:var(--workspace-text,#19273d)}.ds-field{display:flex;align-items:center;min-height:48px;padding:0 13px;background:var(--workspace-bg,#f2f5f9);border:1px solid var(--workspace-line,#dce4ef);border-radius:8px;transition:border-color .16s}.ds-field:focus-within{outline:2px solid var(--brand-orange,#ff8d2a);outline-offset:2px}.ds-field input{width:100%;min-width:0;height:48px;background:none;border:0;color:var(--workspace-text,#19273d);font:14px Inter,system-ui,sans-serif;outline:none}@media(max-width:760px){.ds-field input{font-size:16px}}"
    },
    {
      "name": "Navy Navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Local workspace navigation with orange selected icon.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Workspace\"><button aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"3\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/><rect x=\"14\" y=\"14\" width=\"7\" height=\"7\" rx=\"1\"/></svg>Overview</button><button>Projects</button></nav>",
      "css": ".ds-nav{display:grid;gap:7px;background:#0c2170;padding:16px;max-width:232px}.ds-nav button{display:flex;align-items:center;gap:12px;min-height:46px;padding:12px;border:0;border-radius:8px;background:none;color:#d6e1f7;text-align:left;font:600 13px Inter,system-ui,sans-serif;cursor:pointer;transition:background-color .16s}.ds-nav button[aria-current]{background:#2b438e;box-shadow:inset 0 0 0 1px #4961a3;color:#fff}.ds-nav button[aria-current] svg{color:#ffae65}.ds-nav button:hover{background:#213b85;color:#fff}.ds-nav button:focus-visible{outline:3px solid var(--brand-orange,#ff8d2a);outline-offset:3px}"
    },
    {
      "name": "Project Availability",
      "kind": "chip",
      "refersTo": "availability",
      "description": "Text and icon communicate ready or paused access.",
      "html": "<span class=\"ds-availability\"><svg width=\"13\" height=\"13\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" aria-hidden=\"true\"><path d=\"m20 6-11 11-5-5\"/></svg>Ready to view</span><span class=\"ds-availability ds-paused\">Update under review</span>",
      "css": ".ds-availability{display:inline-flex;align-items:center;gap:5px;color:var(--workspace-success,#16704f);font:11px Inter,system-ui,sans-serif;white-space:nowrap;margin-right:16px}.ds-paused{color:var(--workspace-muted,#596a80)}"
    },
    {
      "name": "Operating Sheet",
      "kind": "card",
      "refersTo": "sheet",
      "description": "Flat grouping for operational information.",
      "html": "<section class=\"ds-sheet\"><h2>Project records</h2><p>Locations, measured profiles and available imagery.</p></section>",
      "css": ".ds-sheet{padding:23px;border:1px solid var(--workspace-line,#dce4ef);border-radius:12px;background:var(--workspace-panel,#fff);color:var(--workspace-text,#19273d);box-shadow:none;font:14px/1.55 Inter,system-ui,sans-serif}.ds-sheet h2{font-size:18px;font-weight:650;letter-spacing:-.025em;margin:0 0 10px}.ds-sheet p{color:var(--workspace-muted,#596a80);margin:0}"
    },
    {
      "name": "Client Deliverables Panel",
      "kind": "custom",
      "refersTo": "delivery-panel",
      "description": "Distinct navy destination for available project files.",
      "html": "<aside class=\"ds-delivery\"><h2>Project deliverables.</h2><p>Available files, measured records and reports, organised in one place.</p><a href=\"/portal\">Browse project files</a></aside>",
      "css": ".ds-delivery{background:#0c2170;color:#fff;border-radius:14px;padding:24px;max-width:285px;font:14px/1.55 Inter,system-ui,sans-serif}.ds-delivery h2{font-size:25px;font-weight:600;letter-spacing:-.025em;margin:0}.ds-delivery p{color:#cad6f1;font-size:13px;line-height:1.7;margin:12px 0 22px}.ds-delivery a{display:flex;justify-content:space-between;gap:12px;background:#fff;color:#0c2170;padding:12px 14px;border-radius:8px;font-size:12px;font-weight:650;text-decoration:none}.ds-delivery a:hover{background:#ffe6cf}.ds-delivery a:focus-visible{outline:3px solid var(--brand-orange,#ff8d2a);outline-offset:3px}"
    },
    {
      "name": "Public Project Enquiry",
      "kind": "button",
      "refersTo": "button-home",
      "description": "Public orange action with native route navigation or local form behavior.",
      "html": "<a class=\"ds-site-button ds-site-orange\" href=\"/contact\">Discuss a project</a>",
      "css": ".ds-site-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:12px 20px;border-radius:8px;border:1px solid transparent;font:600 13px/1.6 Inter,system-ui,sans-serif;letter-spacing:-.01em;text-align:center;text-decoration:none;cursor:pointer;transition:background-color .16s,color .16s,transform .16s}.ds-site-button:focus-visible{outline:3px solid var(--pt-site-orange,#ff8d2a);outline-offset:4px}.ds-site-button:disabled{cursor:not-allowed}.ds-site-orange{background:#ff8d2a;color:#102460}.ds-site-orange:hover{background:#ffac64}"
    },
    {
      "name": "Public Navy Action",
      "kind": "button",
      "refersTo": "button-site-navy",
      "description": "Public navy action with native route navigation or local form behavior.",
      "html": "<button class=\"ds-site-button ds-site-navy\">Prepare enquiry</button>",
      "css": ".ds-site-button{display:inline-flex;align-items:center;justify-content:center;gap:14px;min-height:48px;padding:12px 20px;border-radius:8px;border:1px solid transparent;font:600 13px/1.6 Inter,system-ui,sans-serif;letter-spacing:-.01em;text-align:center;text-decoration:none;cursor:pointer;transition:background-color .16s,color .16s,transform .16s}.ds-site-button:focus-visible{outline:3px solid var(--pt-site-orange,#ff8d2a);outline-offset:4px}.ds-site-button:disabled{cursor:not-allowed}.ds-site-navy{background:#0c2170;color:#fff}.ds-site-navy:hover{background:#29468f}"
